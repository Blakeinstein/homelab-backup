# homelab-backup service environment
# Loaded via EnvironmentFile= by the systemd user unit, and by the CLI via --env.
# Copy this file to homelab-backup.env with real values.

# Where the backup-services.yaml lives (single source of truth, in the homelab repo)
HOMELAB_BACKUP_CONFIG=/home/blaine/homelab/services/homelab-backup/backup-services.yaml

# Data root of the homelab (target of file backup procedures)
HOMELAB_DATA_ROOT=/home/blaine/homelab-data

# Where the restic repo and run history live
HOMELAB_BACKUP_STATE=/home/blaine/homelab-data/backups/state

# Base dir where service quadlet/env files live
HOMELAB_CONTAINER_BASE_DIR=/home/blaine/homelab/services

# Dashboard
HOMELAB_BACKUP_PORT=3095

# Offsite sync (leave OFFSITE_HOST empty to disable, unless the yaml lists offsite.targets)
OFFSITE_HOST=
OFFSITE_PATH=/home/offsite/backups/homelab
# Fallback SSH key for rsync pushes that do not set their own (rsync -e "ssh -i <key>")
OFFSITE_SSH_KEY=
# Minimum hours between scheduled offsite pushes
OFFSITE_MIN_HOURS=20
# restic repository location (overridden by yaml defaults.)
RESTIC_REPOSITORY=/home/blaine/homelab-data/backups/restic

# Log verbosity
HOMELAB_BACKUP_LOG=/home/blaine/homelab-data/backups/state/agent.log
