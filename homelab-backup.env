# homelab-backup service environment (runtime values for this host)

# Where the backup-services.yaml lives (single source of truth, in the homelab repo)
HOMELAB_BACKUP_CONFIG=/home/blaine/homelab/services/homelab-backup/backup-services.yaml

# Data root of the homelab (target of file backup procedures)
HOMELAB_DATA_ROOT=/home/blaine/homelab-data

# Where the restic repo, password, markers and run history live
HOMELAB_BACKUP_STATE=/home/blaine/homelab-data/backups/state

# Base dir where service quadlet/env files live
HOMELAB_CONTAINER_BASE_DIR=/home/blaine/homelab/services

# Dashboard
HOMELAB_BACKUP_PORT=3095

# Offsite sync (leave OFFSITE_HOST empty to disable)
OFFSITE_HOST=
OFFSITE_PATH=
OFFSITE_MIN_HOURS=20
